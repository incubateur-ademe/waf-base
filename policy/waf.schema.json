{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/incubateur-ademe/waf-base/v1/policy/waf.schema.json",
  "title": "waf/waf.yaml",
  "description": "Contacts et rate limit d'une app. wafgen revérifie chaque borne.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "contacts": {
      "type": "array", "maxItems": 10,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,190}\\.[A-Za-z]{2,24}$" }
    },
    "rate_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/$defs/limite" },
        "zones": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "paths", "events", "window", "reason"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$", "not": { "const": "defaut" } },
              "paths": {
                "type": "array", "minItems": 1, "maxItems": 10,
                "items": { "type": "string", "pattern": "^/[A-Za-z0-9._~/-]{0,200}$", "not": { "const": "/" } }
              },
              "methods": {
                "type": "array",
                "items": { "enum": ["GET", "HEAD", "POST", "OPTIONS", "PUT", "PATCH", "DELETE"] }
              },
              "events": { "type": "integer", "minimum": 1 },
              "window": { "enum": ["1s", "10s", "1m"] },
              "reason": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\n\\r{}`]*$" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "limite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "window"],
      "properties": {
        "events": { "type": "integer", "minimum": 1 },
        "window": { "enum": ["1s", "10s", "1m"] }
      }
    }
  }
}
